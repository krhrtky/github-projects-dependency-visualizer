{
  "name": "github-projects-dependency-visualizer",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "package:extension": "pnpm build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.5",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
